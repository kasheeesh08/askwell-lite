# AskWell Lite self-hosted MVP configuration.
# Copy to .env for your own deployment tooling, but do not commit real secrets.

NODE_ENV=production
PORT=4173

# Required outside NODE_ENV=development. Use a long random value.
ASKWELL_ADMIN_TOKEN=replace-with-a-long-random-admin-token

# Comma-separated public hostnames allowed to reach the Node server.
# Include localhost only for local production smoke tests.
ASKWELL_ALLOWED_HOSTS=localhost,127.0.0.1

# Optional Node -> FastAPI bridge.
ASKWELL_AI_SERVICE_URL=http://127.0.0.1:8001
ASKWELL_AI_TIMEOUT_MS=8000

# Optional shared token between Node and FastAPI. Recommended if FastAPI is reachable
# outside the same private host.
ASKWELL_AI_SERVICE_TOKEN=replace-with-a-long-random-service-token

# FastAPI service configuration.
ASKWELL_AI_REQUIRE_TOKEN=1
ASKWELL_AI_DATA_DIR=ai-service/data
ASKWELL_VECTOR_STORAGE_BACKEND=auto
ASKWELL_EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2

# Default generation is free/extractive. Hosted LLM use is opt-in.
ASKWELL_LLM_PROVIDER=extractive
ASKWELL_LLM_MODEL=gpt-4o-mini
ASKWELL_LLM_BASE_URL=https://api.openai.com/v1
# ASKWELL_LLM_API_KEY=
